<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mangoappstudio.symphony-telegram</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BINARY__</string>
    <string>__SYMPHONY_REPO__/bin/symphony.js</string>
    <string>telegram</string>
    <string>--config</string><string>__CONFIG_PATH__</string>
    <string>--token-file</string><string>__HOME__/.config/symphony/telegram-token</string>
    <string>--state-dir</string><string>__HOME__/.config/symphony/telegram-state</string>
  </array>
  <key>WorkingDirectory</key><string>__SYMPHONY_REPO__</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>__RUNNER_PATH__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/Symphony/telegram.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/Symphony/telegram.err.log</string>
</dict>
</plist>
