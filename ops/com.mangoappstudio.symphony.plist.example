<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mangoappstudio.symphony</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BINARY__</string>
    <string>__SYMPHONY_REPO__/bin/symphony.js</string>
    <string>run</string>
    <string>--config</string>
    <string>__SYMPHONY_REPO__/symphony.config.yml</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__SYMPHONY_REPO__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__RUNNER_PATH__</string>
    <key>SYMPHONY_LOG_FORMAT</key>
    <string>pretty</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/Symphony/symphony.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/Symphony/symphony.err.log</string>
</dict>
</plist>
